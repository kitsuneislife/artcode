/src
/target

# Machine-specific build configuration (see docs/guides/installation.md for the
# OneDrive / Smart App Control note that makes it necessary on some Windows setups).
/.cargo/config.toml

# Coverage and profiling
lcov.info
*.json
!calibration_suggestion.json
!profile.json
# The perf baseline is committed data, not an output: without it the CI
# perf-regression job aborts with "baseline file not found".
!baseline/*.json

# Generated artifacts and plans
/artifacts/
aot_plan*.json

# Dynamic outputs / traces / local binaries
test_output.txt
trace.artlog
*.artlog
testbin
demo47
aot_cached_bin
perf.md

# Local cache
.artcache/
*/.artcache/
crates/jit/artcache

# Local working notes/tools
/.kit
*.pdf
.claude

# Temporary workspace files
tmp/dist/

# Package lockfile written by `art add`; the integration tests rewrite it with
# absolute temp paths on every run, so it is local state and not source.
.art-lock

# `art doc` output
docs/generated/
